# Copy this file to .env and replace only the API-key placeholder.
# .env is ignored by Git and stays on this computer.
# Recommended pool: six direct Gemini players, three Hetzner Qwen players,
# and an OpenAI deployment usable by the Game Analyst or a GM-selected player.
# Put real credentials only in .env, never here.
LLM_PROVIDER=pool

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_1=replace-with-gemini-key-1
GEMINI_API_KEY_2=replace-with-gemini-key-2
GEMINI_API_KEY_3=replace-with-gemini-key-3
GEMINI_API_KEY_4=replace-with-gemini-key-4
GEMINI_API_KEY_5=replace-with-gemini-key-5
GEMINI_API_KEY_6=replace-with-gemini-key-6

HETZNER_BASE_URL=https://inference.hetzner.com/api/v1
HETZNER_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
HETZNER_API_KEY_1=replace-with-hetzner-key-1
HETZNER_API_KEY_2=replace-with-hetzner-key-2
HETZNER_API_KEY_3=replace-with-hetzner-key-3

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_ANALYST_MODEL=gpt-5.6-luna

# Optional typed-decision gate for vote and night actions. Jev never writes
# player-facing chat; it selects only a legal target and confidence.
TYPESAFE_API_KEY=replace-with-typesafe-api-key
TYPESAFE_MODEL=jev-latest

# Optional: self-hosted LiteLLM replacement/fallback gateway.
# LLM_PROVIDER=litellm
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# LITELLM_API_KEY=replace-with-your-litellm-key
# LLM_PLAYER_MODELS=gemini/gemini-2.5-flash-lite
# LLM_ANALYST_MODEL=openai/gpt-4.1-mini

LLM_MIN_REQUEST_INTERVAL_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=180
# Public discussion and private Mafia discussion need slightly more room than
# compact action commands, especially with Persian JSON text.
LLM_SPEAK_MAX_OUTPUT_TOKENS=512
# GPT reasoning tokens count toward max_completion_tokens. `minimal` leaves
# enough completion budget for a valid JSON game command.
OPENAI_REASONING_EFFORT=low
LLM_REQUEST_TIMEOUT_SECONDS=180
# Hard end-to-end deadline for one Agent decision, including model failover.
LLM_DECISION_TIMEOUT_SECONDS=45
# Jev should be fast; fail open to the validated model/fallback target if it stalls.
TYPESAFE_DECISION_TIMEOUT_SECONDS=15
LLM_ANALYST_MAX_OUTPUT_TOKENS=700

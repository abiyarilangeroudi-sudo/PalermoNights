{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palermo-nights",
  "main": ".worker-build/worker.py",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./Frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "code_update_strategy": {
      "mode": "immediate"
    },
    "bindings": [
      {
        "name": "GAME_SERVER",
        "class_name": "GameServer"
      }
    ]
  },
  "exports": {
    "GameServer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "python3 scripts/package_worker.py"
  }
}

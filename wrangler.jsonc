{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palermo-nights",
  "main": "worker.py",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./Frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SERVER",
        "class_name": "GameServer"
      }
    ]
  },
  "exports": {
    "GameServer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
